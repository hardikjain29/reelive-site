---
/** The lockup: the mark, then "reelive." with the pink dot (the app's components/brand/Logo.tsx). */
import Mark from './Mark.astro';
import { WORDMARK_DOT, WORDMARK_LETTERS, WORDMARK_WIDTH } from '../brand/wordmark';

interface Props {
  scale?: number;
}
const { scale = 1 } = Astro.props;
const h = 24 * scale;
---

<span class="logo" style={`gap:${(7 * scale).toFixed(1)}px`}>
  <Mark size={30 * scale} />
  <svg width={((h * WORDMARK_WIDTH) / 100).toFixed(1)} height={h} viewBox={`0 0 ${WORDMARK_WIDTH} 100`} aria-hidden="true">
    <path d={WORDMARK_LETTERS} fill="#F5F5F7"></path>
    <path d={WORDMARK_DOT} fill="#FF4F97"></path>
  </svg>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
  }
</style>
