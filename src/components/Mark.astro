---
/**
 * The "Selects" mark: a 5×5 camera-roll grid whose nine AI-picked tiles are lit
 * and form a play button (the app's components/brand/Mark.tsx).
 */
import { nextId } from '../lib/ids';

interface Props {
  size?: number;
  class?: string;
}
const { size = 30, class: cls } = Astro.props;
const LIT = new Set(['1,0', '1,1', '1,2', '1,3', '1,4', '2,1', '2,2', '2,3', '3,2']);
const UNLIT = [0.1, 0.15, 0.08, 0.13, 0.11, 0.14, 0.09, 0.12, 0.16, 0.1, 0.08, 0.13, 0.1, 0.15, 0.09, 0.12, 0.1, 0.16, 0.08, 0.14, 0.15, 0.09, 0.12, 0.1, 0.13];
const id = nextId('lit');
const tiles = Array.from({ length: 25 }, (_, i) => {
  const col = i % 5;
  const row = Math.floor(i / 5);
  return { x: 8 + col * 17.5, y: 8 + row * 17.5, lit: LIT.has(`${col},${row}`), opacity: UNLIT[i] };
});
---

<svg width={size} height={size} viewBox="0 0 100 100" class={cls} aria-hidden="true">
  <defs>
    <linearGradient id={id} gradientUnits="userSpaceOnUse" x1="22" y1="8" x2="78" y2="92">
      <stop offset="0" stop-color="#FF86BA"></stop>
      <stop offset="0.5" stop-color="#FF3E8F"></stop>
      <stop offset="1" stop-color="#C0125F"></stop>
    </linearGradient>
  </defs>
  {
    tiles.map((t) =>
      t.lit ? (
        <rect x={t.x} y={t.y} width="14" height="14" rx="4.2" fill={`url(#${id})`} />
      ) : (
        <rect x={t.x} y={t.y} width="14" height="14" rx="4.2" fill="#FFFFFF" fill-opacity={t.opacity} />
      )
    )
  }
</svg>
