---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppButton from '../components/AppButton.astro';
import Icon from '../components/Icon.astro';
import Mark from '../components/Mark.astro';
import { SITE } from '../site';
import { still } from '../lib/stills';
import { EXTRAS, REEL_CUTS, REEL_LENGTH, SHOTS, shotLength } from '../lib/showcase';
import { waveHeights } from '../lib/wave';
import '../styles/landing.css';

// The showcase: 40 photos and videos go in, the 17 lit tiles are "picked", and the phone
// plays the reel they make: a template's own video, muted, one lit tile per shot. The
// timeline under it shows the same shots at their real lengths, with a playhead that
// follows the video (the script at the bottom; without it, a CSS loop of the same length).
const COLS = 8;
const ROWS = 5;
const LIT_ORDER = ['0,1', '0,3', '1,0', '1,2', '1,4', '2,1', '2,3', '3,0', '3,2', '4,1', '4,4', '5,0', '5,2', '5,3', '6,1', '6,4', '7,2'];
/** Which shot of the reel each lit tile is: the camera roll isn't in the reel's order. */
const LIT_SHOT = [5, 0, 12, 8, 2, 15, 10, 3, 7, 14, 1, 11, 6, 16, 4, 13, 9];
// Some tiles are videos, shown like the camera roll does (duration in the corner). For the
// picked ones, `from` is the second Reelive started at: the trim bar on the tile and the
// tag on the timeline clip show it, so it's clear videos go in too and only the best part is kept.
const VIDEOS: Record<string, { length: number; from?: number }> = {
  '1,2': { length: 21, from: 9 },
  '3,0': { length: 14, from: 3 },
  '5,3': { length: 32, from: 12 },
  '6,1': { length: 9, from: 4 },
  '0,0': { length: 8 },
  '2,4': { length: 11 },
  '4,2': { length: 6 },
  '6,0': { length: 17 },
  '7,4': { length: 12 },
  '3,3': { length: 5 },
};
const clock = (s: number) => `0:${String(Math.floor(s)).padStart(2, '0')}`;

let dimmed = 0;
const tiles = Array.from({ length: COLS * ROWS }, (_, i) => {
  const col = i % COLS;
  const key = `${col},${Math.floor(i / COLS)}`;
  const pick = LIT_ORDER.indexOf(key);
  const on = pick >= 0;
  const shot = on ? LIT_SHOT[pick] : null;
  const video = VIDEOS[key];
  const used = shot === null ? 0 : shotLength(shot);
  return {
    on,
    shot,
    src: shot === null ? EXTRAS[dimmed++] : SHOTS[shot],
    delay: `${on ? (col * 0.16).toFixed(2) : (col * 0.04).toFixed(2)}s`,
    video: video && {
      length: clock(video.length),
      trim:
        on && video.from !== undefined
          ? { left: `${((video.from / video.length) * 100).toFixed(1)}%`, width: `${((used / video.length) * 100).toFixed(1)}%` }
          : null,
    },
  };
});
/** The timeline's clips, in the reel's order and at their lengths; `video` marks the ones cut from a video. */
const clips = SHOTS.map((src, i) => ({ src, video: Boolean(tiles.find((t) => t.shot === i)?.video?.trim) }));
const clipColumns = REEL_CUTS.map((_, i) => `${shotLength(i).toFixed(2)}fr`).join(' ');
const cuts = REEL_CUTS.slice(1).map((t) => `${((t / REEL_LENGTH) * 100).toFixed(3)}%`);
const WAVE_BARS = 72;
const wave = waveHeights(WAVE_BARS, REEL_CUTS.slice(1).map((t) => Math.round((t / REEL_LENGTH) * WAVE_BARS)));
const times = [0, 1, 2, 3].map((k) => clock((k / 3) * REEL_LENGTH));
const strip = Array.from({ length: 24 }, (_, i) => still(i * 7));

const yours = [
  ['Choose the kind of reel', 'A trip, a birthday, a recap, a trend. Every template is already timed to its song.'],
  ['Add all your photos and videos', 'Don’t choose. Throw in the whole lot, photos and clips together.'],
];
// Only what the AI step really does: picks per scene, one shot per near-duplicate group,
// the best window in each video, cut to the template's beat.
const ours = [
  'Picks the best photos and clips',
  'Skips the near-duplicates',
  'Finds the best seconds in every video',
  'Puts each moment in the right spot',
  'Cuts everything to the beat',
  'Hands you a finished reel, ready to post',
];
const pro = ['Make as many reels as you like', 'Try another template whenever you want', 'Your reels are made first'];
const tiers = [
  { name: 'Free', amount: '$0', note: 'Try it on your own photos.', items: [`Your first ${SITE.freeReels} reels`, 'Every template', 'No watermark'] },
  { name: 'Pro Yearly', badge: 'Best value', amount: SITE.prices.yearly, per: '/ year', note: `Just ${SITE.prices.yearlyPerWeek} a week. Cancel anytime.`, items: pro, pro: true },
  { name: 'Week Pass', amount: SITE.prices.weekPass, per: '/ week', note: 'Paid once. Ends after 7 days and never renews.', items: pro },
];
const faq = [
  ['Do I have to choose my best photos?', 'No, that’s the point. Add all of them. Reelive looks at every photo and clip, skips the near-duplicates and keeps the best moments for your reel.'],
  ['Do I have to trim my videos?', 'No. Add the whole video, straight from your camera roll. Reelive watches it, picks the seconds that fit the template best and cuts them in on the beat. No hunting for the good part, no trimming, no putting clips together in an editor.'],
  ['Is Reelive free?', `Your first ${SITE.freeReels} reels are free, with every template and no watermark. After that, Pro Yearly or a Week Pass lets you make as many reels as you like.`],
  ['Do I need an account?', 'You can look around without one. To make a reel, sign in with Apple or Google, so your reels are saved to your account.'],
  ['What happens to my photos?', 'They’re used only to make your reels. They’re never posted anywhere or used for ads, and they’re deleted when you delete your account. The <a href="/privacy">Privacy Policy</a> has the details.'],
  ['Can I post to TikTok and Instagram?', 'Yes. Reels come out vertical, with no watermark, ready for TikTok, Instagram Reels and YouTube Shorts.'],
  ['How do I cancel?', 'Pro Yearly renews until you cancel it in your Apple ID settings, at least 24 hours before it ends. The Week Pass never renews, so there’s nothing to cancel.'],
  ['How do I delete my account?', `In the app, go to Settings → Delete account. Or email <a href="mailto:${SITE.supportEmail}">${SITE.supportEmail}</a> and we’ll do it for you.`],
];
---

<BaseLayout title="Reelive: add all your photos and videos, get a reel">
  <section class="r-hero">
    <div class="r-dots" aria-hidden="true"></div>
    <div class="r-wrap">
      <span class="r-badge"><Icon name="phone" size={15} />{SITE.appStoreLive ? 'Now on iPhone' : 'Coming soon to iPhone'}</span>
      <h1 class="r-h1"><span>Add all your photos and videos.</span> <span>We’ll make the reel.</span></h1>
      <p class="r-sub">No sorting, no picking, no editing. Choose the kind of reel you want and Reelive does the rest.</p>
      <div class="r-ctas">
        <AppButton place="hero" />
        <a class="r-btn lg r-outline" href="#how">How it works <Icon name="arrowDown" size={17} /></a>
      </div>
      <p class="r-free">Your first {SITE.freeReels} reels are free.</p>

      <figure class="r-show">
        <figcaption class="sr-only">
          Forty photos and videos go in. Reelive picks the seventeen best moments, taking just the best seconds of each video, and plays them as a reel with every cut on the beat of the music.
        </figcaption>
        <div class="r-stage" aria-hidden="true">
          <div class="r-fig">
            <div class="r-gridhead">
              <p class="r-label r-add">You add <b>{tiles.length}</b></p>
              <p class="r-label r-picks">
                <span class="r-dot"><Icon name="check" size={10} bold /></span>Reelive picks <b>{tiles.filter((t) => t.on).length}</b>
              </p>
            </div>
            <div class="r-grid">
              {
                tiles.map((t) => (
                  <div class:list={['t', { on: t.on, video: t.video }]} style={`animation-delay:${t.delay}`}>
                    <img src={t.src} alt="" width="360" height="640" decoding="async" />
                    {t.on && (
                      <span class="ck">
                        <Icon name="check" size={12} bold />
                      </span>
                    )}
                    {t.video && (
                      <span class="vid">
                        <svg viewBox="0 0 24 24"><path d="M7 4v16l13-8z"></path></svg>
                        {t.video.length}
                      </span>
                    )}
                    {t.video?.trim && (
                      <span class="trim">
                        <i style={`left:${t.video.trim.left};width:${t.video.trim.width}`}></i>
                      </span>
                    )}
                  </div>
                ))
              }
            </div>
          </div>
          <div class="r-flow">
            <span>Made into</span>
            <svg class="r-arrow ic" viewBox="0 0 96 20"><path d="M2 10h88"></path><path d="M82 3l8 7-8 7"></path></svg>
            <span>a reel</span>
          </div>
          <div class="r-fig">
            <p class="r-label"><b>What you get</b></p>
            <div class="phone" style="width:250px">
              <div class="phone-screen">
                <div class="reel">
                  <video class="reel-video" src="/demo/reel.mp4" poster="/demo/reel-poster.jpg" muted loop playsinline preload="auto" width="540" height="960"></video>
                  <span class="reel-bar"></span>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="r-tl" aria-hidden="true">
          <div class="r-tlhead">
            <p class="r-label pink">Cut to the beat</p>
            <span>Each cut lands on the music. From a video, Reelive takes just the best seconds.</span>
          </div>
          <div class="r-track">
            <div class="r-clips" style={`grid-template-columns:${clipColumns}`}>
              {
                clips.map((c) => (
                  <div>
                    <img src={c.src} alt="" width="360" height="640" decoding="async" />
                    {c.video && (
                      <span class="r-cliptag">
                        <svg viewBox="0 0 24 24"><path d="M7 4v16l13-8z"></path></svg>
                      </span>
                    )}
                  </div>
                ))
              }
            </div>
            <div class="r-wave">{wave.map((h) => <span class="wb" style={`height:${h}%`}></span>)}</div>
            {cuts.map((left) => <span class="r-cut" style={`left:${left}`}></span>)}
            <span class="r-head"></span>
          </div>
          <div class="r-times">{times.map((t) => <span>{t}</span>)}</div>
        </div>
      </figure>
      <script>
        // The phone plays the reel only while it's on screen, and not at all when the visitor
        // asked for less motion (the poster stays). While it plays, the timeline's playhead
        // and the phone's progress bar follow the video's own clock instead of a CSS loop.
        const show = document.querySelector<HTMLElement>('.r-show');
        const video = show?.querySelector<HTMLVideoElement>('.reel-video');
        if (show && video) {
          const lessMotion = matchMedia('(prefers-reduced-motion: reduce)');
          const tick = () => {
            if (video.duration) show.style.setProperty('--p', String(video.currentTime / video.duration));
            if (!video.paused) requestAnimationFrame(tick);
          };
          video.addEventListener('playing', () => {
            show.classList.add('synced');
            requestAnimationFrame(tick);
          });
          new IntersectionObserver(([entry]) => {
            if (entry.isIntersecting && !lessMotion.matches) video.play().catch(() => {});
            else video.pause();
          }).observe(video);
        }
      </script>
    </div>
  </section>

  <section class="r-section r-parts" id="how" aria-labelledby="how-title">
    <div class="r-wrap">
      <h2 class="r-h2" id="how-title">You do two things.<br />Reelive does the rest.</h2>
      <div class="r-split">
        <div class="r-side">
          <h3 class="r-label">Your part</h3>
          <ol class="r-mine">
            {
              yours.map(([h, p], i) => (
                <li class="r-row">
                  <span class="r-big" aria-hidden="true">0{i + 1}</span>
                  <h4>{h}</h4>
                  <p>{p}</p>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="r-side ours">
          <h3 class="r-label pink">Reelive’s part</h3>
          <ul class="r-ours">
            {
              ours.map((t) => (
                <li>
                  <span class="r-ok">
                    <Icon name="check" size={15} bold />
                  </span>
                  {t}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="r-section" id="templates" aria-labelledby="templates-title">
    <div class="r-wrap">
      <p class="r-label pink">Templates</p>
      <h2 class="r-h2" id="templates-title">The only choice you make: what kind of reel.</h2>
      <p class="r-lead">Travel, recaps, birthdays and trends, each one already timed to its song.</p>
      <div class="r-bento">
        <div class="r-card wide">
          <span class="r-ic"><Icon name="film" size={19} /></span>
          <h3>A template for every moment</h3>
          <p>{SITE.templates} to choose from. Pick one, add your photos, done.</p>
          <ul class="r-cats" aria-label="Categories">
            <li>Travel</li><li>Trending</li><li>Lifestyle</li><li>Recap</li><li>Celebrations</li><li>Adventures</li>
          </ul>
          <div class="r-strip" aria-hidden="true">
            {strip.map((src) => <img src={src} alt="" width="360" height="640" loading="lazy" decoding="async" />)}
          </div>
        </div>
        <div class="r-card">
          <span class="r-ic"><Icon name="type" size={19} /></span>
          <h3>Your words on screen</h3>
          <p>Change the text in any template to say what you want.</p>
        </div>
        <div class="r-card">
          <span class="r-ic"><Icon name="badge" size={19} /></span>
          <h3>Ready to post</h3>
          <p>No watermark. Made for TikTok, Reels and Shorts.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="r-section" id="pricing" aria-labelledby="pricing-title">
    <div class="r-wrap">
      <p class="r-label pink">Pricing</p>
      <h2 class="r-h2" id="pricing-title">Two reels on us. Then go Pro.</h2>
      <div class="r-prices">
        {
          tiers.map((t) => (
            <div class:list={['r-price', { pro: t.pro }]}>
              <h3 class="r-tier">
                <span>{t.name}</span>
                {t.badge && <span class="r-pill">{t.badge}</span>}
              </h3>
              <p class="r-amt">
                {t.amount}
                {t.per && <small> {t.per}</small>}
              </p>
              <p class="r-note">{t.note}</p>
              <ul class="r-list">
                {t.items.map((item) => (
                  <li>
                    <Icon name="check" size={16} />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="r-fine">
        Prices in US dollars. The App Store shows the price in your currency. Yearly renews until you cancel in your Apple ID
        settings. See the <a href="/terms" style="color:inherit">Terms</a>.
      </p>
    </div>
  </section>

  <section class="r-section" id="faq" aria-labelledby="faq-title">
    <div class="r-wrap r-faq">
      <div>
        <p class="r-label pink">FAQ</p>
        <h2 class="r-h2" id="faq-title">Questions, answered.</h2>
        <p class="r-ask">Something else? Write to <a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a>.</p>
      </div>
      <div class="r-qs">
        {
          faq.map(([q, a], i) => (
            <details class="r-q" open={i === 0}>
              <summary>
                {q}
                <Icon name="plus" size={20} />
              </summary>
              <p set:html={a} />
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <div class="r-wrap">
    <section class="r-end" aria-labelledby="end-title">
      <Mark size={56} />
      <h2 class="r-h2" id="end-title">Stop picking photos.<br />Start posting reels.</h2>
      <p class="r-sub">Choose the kind of reel. Add everything. Reelive does the rest.</p>
      <div class="r-ctas"><AppButton place="end" /></div>
      <p class="r-free">Your first {SITE.freeReels} reels are free.</p>
    </section>
  </div>
</BaseLayout>
